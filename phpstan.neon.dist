includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        - '#Class Spatie\\Permission\\Models\\Role not found#'
        - '#Class Spatie\\Permission\\Models\\Permission not found#'
